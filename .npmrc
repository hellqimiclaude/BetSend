; Never run a dependency's install scripts.
;
; This is not a style preference, it is what keeps the office PC from needing
; Visual Studio. better-sqlite3 ships a compiled binary for every platform
; inside its own package (node_modules/better-sqlite3/prebuilds/win32-x64.node)
; and loads it at runtime -- but it also ships a binding.gyp, and npm treats a
; package with a binding.gyp and no install script as one to compile, so it
; runs `node-gyp rebuild` before the prebuilt binary is ever consulted. On
; Linux that quietly succeeds because a C++ toolchain is there. On Windows it
; fails with "could not find any Visual Studio installation to use", which is
; exactly the error this project exists to spare people.
;
; Nothing in the dependency tree needs an install script: esbuild's is a
; version check, and better-sqlite3's is the problem above. `prepare` scripts
; do not run for registry tarballs at all.
;
; If a future dependency genuinely needs one, run it by name with
; `npm rebuild <package>` rather than turning this off.
ignore-scripts=true
