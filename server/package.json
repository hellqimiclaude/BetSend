{
  "name": "@betsend/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --import ./test/setup.mjs --test --test-reporter spec 'test/**/*.test.ts'",
    "test:watch": "node --import tsx --import ./test/setup.mjs --test --watch 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.2",
    "@tus/file-store": "^1.5.1",
    "@tus/server": "^1.10.1",
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.2.1",
    "mime-types": "^2.1.35",
    "nodemailer": "^10.1.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
