{
  "name": "@betsend/desktop",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test --test-reporter spec 'test/**/*.test.ts'",
    "package": "npm run build && node scripts/package.mjs --win",
    "package:linux": "npm run build && node scripts/package.mjs --linux dir"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "description": "BetSend desktop client \u2014 send files to colleagues without opening a browser.",
  "author": "BetLive",
  "dependencies": {
    "tus-js-client": "^4.3.1"
  }
}
